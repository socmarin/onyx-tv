<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/wallpaper_picker_dialog_bg"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="22dp"
    android:paddingEnd="26dp"
    android:paddingBottom="22dp">

    <TextView
        android:id="@+id/inputCustomizeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@string/font_medium"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

    <LinearLayout
        android:id="@+id/inputCustomizeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/settings_group_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="63dp"
            android:background="@drawable/input_tile_thumb_bg"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/inputCustomizePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/inputCustomizeHeaderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@string/font_medium"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/inputCustomizeHeaderPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#8CFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/inputCustomizeList"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="4dp"
        android:drawSelectorOnTop="false"
        android:fadeScrollbars="false"
        android:listSelector="@drawable/wallpaper_picker_item_selector"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />
</LinearLayout>
