<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/wallpaper_picker_dialog_bg"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="22dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/wallpaper_label"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ListView
            android:id="@+id/wallpaperList"
            android:layout_width="310dp"
            android:layout_height="320dp"
            android:choiceMode="singleChoice"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="2dp"
            android:drawSelectorOnTop="false"
            android:fadeScrollbars="false"
            android:listSelector="@drawable/wallpaper_picker_item_selector"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <FrameLayout
            android:id="@+id/wallpaperPreviewFrame"
            android:layout_width="455dp"
            android:layout_height="256dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/wallpaper_preview_frame"
            android:focusable="false"
            android:padding="1dp">

            <include layout="@layout/view_home_preview" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
